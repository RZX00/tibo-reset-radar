{
  "name": "tibo-reset-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter @tibo-radar/contracts build && pnpm --filter @tibo-radar/db build && pnpm --filter @tibo-radar/signal build && pnpm --filter @tibo-radar/forecast build && pnpm --filter @tibo-radar/x-source build && pnpm --filter @tibo-radar/worker build",
    "typecheck": "pnpm build:packages && pnpm typecheck:all",
    "typecheck:all": "pnpm -r --if-present typecheck",
    "test": "pnpm build:packages && pnpm test:all",
    "test:all": "vitest run",
    "test:integration": "pnpm build:packages && tsx scripts/demo-e2e.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev:web": "pnpm --filter @tibo-radar/web dev",
    "dev:api": "pnpm --filter @tibo-radar/api dev",
    "dev:worker": "pnpm --filter @tibo-radar/worker dev",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts --status",
    "contracts:check": "tsx scripts/check-contracts.ts",
    "model:backtest": "pnpm build:packages && tsx scripts/backtest.ts",
    "oss:scan": "tsx scripts/scan-oss-surface.ts",
    "check": "pnpm lint && pnpm build && pnpm typecheck:all && pnpm test:all && pnpm oss:scan"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
