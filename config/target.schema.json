{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tibo-reset.ewo.so/contracts/target.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "target",
    "authoritativeUserIds",
    "resetDefinition",
    "bankedResetPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "mode": { "enum": ["demo", "live"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "handle", "displayName"],
      "properties": {
        "userId": { "type": "string", "minLength": 1 },
        "handle": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$" },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "authoritativeUserIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "resetDefinition": { "type": "string", "minLength": 1 },
    "bankedResetPolicy": { "enum": ["confirm", "forecast_only", "ignore"] }
  }
}
