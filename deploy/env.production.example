RADAR_IMAGE=ghcr.io/rzx00/tibo-reset-radar:0.2.0
RADAR_BIND_ADDRESS=127.0.0.1
RADAR_PORT=4173
# Mounted over /app/config/target.json. Point it at an untracked live target file to go live.
RADAR_TARGET_CONFIG_FILE=./target.demo.json
DEMO_MODE=true
# poll = this deployment calls the X API itself; inbox = an operator-run collector pushes posts in
RADAR_COLLECTOR_MODE=poll
# Required only for inbox mode. Long random value; the local collector sends it as a bearer token.
RADAR_INGEST_TOKEN=
POLL_INTERVAL_MS=120000
X_BEARER_TOKEN=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
# Snapshot retention. Recent snapshots stay whole, the last month thins to hourly, older to daily.
RADAR_RETENTION_FULL_HOURS=6
RADAR_RETENTION_HOURLY_DAYS=30
RADAR_RETENTION_INBOX_DAYS=7
